{
  "componentName": "ToggleSwitch",
  "properties": {
    "size": {
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    "state": {
      "type": "enum",
      "values": [
        "off",
        "on",
        "disabled"
      ],
      "default": "off"
    }
  },
  "tokens": {
    "track.off.background": "{color.neutral.700}",
    "track.on.background": "{color.green.500}",
    "thumb.background": "{color.neutral.0}",
    "focus.outline": "{color.green.300}"
  },
  "behaviours": {
    "onClick": "toggle(state.off,state.on)",
    "disabled": "noInteraction"
  },
  "notes": {
    "handoff": "Used by dev & QA as a contract for states, tokens and behaviour."
  }
}